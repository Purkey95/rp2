# MonitorCLT voice webhook — copy to .env (gitignored) and fill in on the host.
# Point your Twilio number's Voice webhook (A CALL COMES IN) at:
#   POST  https://<PUBLIC_BASE_URL>/voice/inbound

TWILIO_AUTH_TOKEN=        # from Twilio console; gates every request (never commit)
OPERATOR_NUMBER=+1704XXXXXXX   # where hot calls warm-transfer (your cell / partner)
PUBLIC_BASE_URL=https://calls.cltbuys.com   # the exact public https base Twilio calls
BUSINESS_NAME=CLT Buys

RECORD_CALLS=true
TWO_PARTY_CONSENT=false   # set true for two-party-consent states -> adds the recording notice

# Screen-pop data sources (wire to Postgres on the host; CSV/JSONL for now)
CONTACTS_CSV=sample/contacts.csv     # phone -> apn (+owner)
LEADS_JSONL=sample/leads.jsonl       # apn -> Owner Distress Score lead (score module output)

CALL_LOG=call_log.jsonl              # every inbound call's screen pop is appended here
SCREENPOP_WEBHOOK=                   # optional: POST the screen pop to a dashboard / Slack / CRM
PORT=8080
