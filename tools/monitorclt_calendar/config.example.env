# MonitorCLT Google Calendar bridge — copy to .env (gitignored) and fill in on the host.
#   cp config.example.env .env
#   python3 oauth.py --authorize        # one time, in a browser -> prints the refresh token
#   python3 oauth.py --check            # confirms it works headlessly from then on

# --- OAuth client (Google Cloud Console -> APIs & Services -> Credentials -> Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=          # never commit; the .env in this directory is gitignored
GOOGLE_REFRESH_TOKEN=          # printed by `python3 oauth.py --authorize`

# --- Where catalysts are WRITTEN.
# Use a calendar dedicated to MonitorCLT rather than your personal one: it can be
# toggled off in the Google Calendar sidebar, shared with a partner, and cleared
# without touching anything else. `python3 sync.py calendars` lists the ids.
CALENDAR_ID=

# --- Where hand-entered dates are READ from (comma-separated).
# Include the MonitorCLT calendar plus anywhere you actually type parcel dates —
# your personal calendar, the Charlotte REIA calendar, a partner's shared one.
# An event only becomes a catalyst if it names a parcel ("APN 12345678" /
# "parcel: 123-45-6") and a catalyst word ("rezoning hearing", "loan maturity").
PULL_CALENDAR_IDS=
