{
  "version": "2.0",
  "_comment": "Thresholds are on calibrated probability. seed_weights are log-odds that reproduce the v1 additive scores as a starting point; training replaces them with measured values and shrinks toward these when labels are few. Nothing here is a proxy for a protected characteristic; no criminal-justice signal exists as an input.",

  "thresholds": {
    "auto_confirm": 0.85,
    "review_floor": 0.45,
    "common_name_records": 8
  },

  "seed_intercept": 0.2,
  "seed_weights": {
    "name_full_exact": 0.65,
    "estate_marker_on_candidate": 1.0,
    "mailing_address_match": 0.9,
    "situs_address_match": 0.6,
    "street_address_match": 0.4,
    "deed_grantor_link": 0.9,
    "deed_grantee_link": 0.5,
    "related_party_on_candidate": 0.7,
    "middle_initial_conflict": -1.3,
    "suffix_conflict": -1.3,
    "organization_candidate": -2.5,
    "county_mismatch": -2.5,
    "common_name": -0.8
  },

  "corroborating": [
    "estate_marker_on_candidate",
    "mailing_address_match",
    "situs_address_match",
    "deed_grantor_link",
    "deed_grantee_link",
    "related_party_on_candidate"
  ],
  "hard_conflicts": ["middle_initial_conflict", "suffix_conflict"],

  "gates": {
    "same_county": true,
    "not_organization": true,
    "corroboration_required": true,
    "no_hard_conflict": true
  },

  "tier_priority": [
    "estate_marker_on_candidate",
    "deed_grantor_link",
    "mailing_address_match",
    "related_party_on_candidate",
    "deed_grantee_link",
    "situs_address_match",
    "street_address_match"
  ],

  "training": {
    "l2_to_seed": 1.0,
    "learning_rate": 0.1,
    "epochs": 400
  }
}
